rules_version = '2';
// Storage: plan revisions live under projects/{pid}/, readable and writable only by the project's
// verified editors (checked against Firestore `editorEmails`). Share snapshots live under
// shared/{token}.json: public read-only, with the unguessable 32-hex token as the secret, and
// writable only by editors of the share's project.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isEditor(pid) {
      return signedIn() && request.auth.token.email.lower() in
        firestore.get(/databases/(default)/documents/projects/$(pid)).data.editorEmails;
    }
    function sizeOk() {
      return request.resource == null || request.resource.size < 96 * 1024 * 1024;
    }

    match /projects/{pid}/{path=**} {
      allow read: if isEditor(pid);
      allow write: if isEditor(pid) && sizeOk();
    }

    match /shared/{file} {
      allow get: if true;            // the unguessable token is the secret
      allow list: if false;
      allow write: if file.matches('[a-f0-9]{32}\\.json')
        && isEditor(firestore.get(/databases/(default)/documents/shares/$(file.split('\\.')[0])).data.projectId)
        && sizeOk();
    }
  }
}
