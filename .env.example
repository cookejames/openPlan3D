# Firebase web app config: Firebase console → Project settings → Your apps → Web app
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
# Optional: enables Google Analytics
PUBLIC_FIREBASE_MEASUREMENT_ID=
# Dev/test only: route Auth, Firestore and Storage to the local emulators and expose a test sign-in hook.
# Never set this in a deployed environment. Used by `npm run test:e2e:cloud`.
# PUBLIC_FIREBASE_USE_EMULATORS=true
