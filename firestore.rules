rules_version = '2';
// Firestore: projects are read and written by verified-email editors listed in `editorEmails`.
// Project creation is gated by `config/access.allowedEmails`, which only the console can change.
// Share tokens (`shares/{token}`) are created and deleted by project editors.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function me() { return request.auth.token.email.lower(); }
    function allowlisted() {
      return me() in get(/databases/$(db)/documents/config/access).data.allowedEmails;
    }
    function isEditor(data) { return signedIn() && me() in data.editorEmails; }

    match /config/{doc} { allow read, write: if false; }   // console only

    match /projects/{pid} {
      allow read: if isEditor(resource.data);
      allow create: if signedIn() && allowlisted()
        && request.resource.data.ownerUid == request.auth.uid
        && me() in request.resource.data.editorEmails
        && request.resource.data.rev == 0;
      allow update: if isEditor(resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (request.resource.data.rev == resource.data.rev
            || request.resource.data.rev == resource.data.rev + 1)
        // only the owner may change who edits
        && (request.resource.data.editorEmails == resource.data.editorEmails
            || request.auth.uid == resource.data.ownerUid);
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;
    }

    match /shares/{token} {
      function projectOf(pid) { return get(/databases/$(db)/documents/projects/$(pid)).data; }
      allow get: if signedIn();
      allow list: if false;
      allow create: if isEditor(projectOf(request.resource.data.projectId));
      allow delete: if isEditor(projectOf(resource.data.projectId));
      allow update: if false;
    }
  }
}
